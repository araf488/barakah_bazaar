# The API's environment on the VM: /opt/barakah/app.env (mode 600, never committed).
# setup.sh writes it once from this template, filling every __PLACEHOLDER__ with a fresh value.
# Edit by hand afterwards (then: cd /opt/barakah && docker compose up -d app).
NODE_ENV=production
PORT=3000
WEB_ENABLED=true
LOG_LEVEL=info
SWAGGER_ENABLED=false

# Postgres runs beside the app in the same compose project; "postgres" is its service name.
DATABASE_URL=postgresql://barakah_app:__APP_DB_PASSWORD__@postgres:5432/barakah?schema=public

# Signing key for access tokens and the key that encrypts staff TOTP secrets. Changing the
# first signs everyone out; changing the second locks out every staff member enrolled in MFA.
JWT_SECRET=__JWT_SECRET__
TOTP_ENCRYPTION_KEY=__TOTP_ENCRYPTION_KEY__

APP_PUBLIC_BASE_URL=https://barakahstore.org
API_PUBLIC_BASE_URL=https://barakahstore.org
CORS_ALLOWED_ORIGINS=https://barakahstore.org,https://www.barakahstore.org

# Exactly one proxy in front of the app: this VM's nginx (Cloudflare's hop is resolved there).
TRUST_PROXY_HOPS=1

# Nothing below is configured yet; each stays on its safe noop default until it is.
QUEUE_ENABLED=false
PAYMENT_PROVIDER=noop
EMAIL_PROVIDER=noop
SMS_PROVIDER=noop

# Optional Supabase Storage for admin image uploads. Set both or neither.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
