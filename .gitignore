# dependencies
node_modules/

# generated Prisma client (rebuilt by `npm run prisma:generate`)
src/generated/

# build output
dist/
build/
*.tsbuildinfo

# environment — never commit real credentials
.env
.env.*
!.env.example

# logs
logs/
*.log
npm-debug.log*

# test output
coverage/
.nyc_output/

# editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
*.swp

# supabase local stack
supabase/.branches/
supabase/.temp/

# prisma migrations are DELIBERATELY tracked — do not ignore them. CI applies
# them with `prisma migrate deploy` (.github/workflows/ci.yml), which reads the
# committed migration.sql files; ignoring them silently turns every deploy into
# a no-op. prisma/rls/*.sql is likewise part of the schema contract.
#
# Ad-hoc SQL that is NOT part of that history — scratch queries, one-off
# backfills, local experiments — goes here instead and stays out of the repo.
/prisma/sql/local/*
!/prisma/sql/local/.gitkeep

# documentation and local planning artefacts (specs, plans, product plan) — kept
# out of the public repo entirely
/docs/

# local orchestration scratch — never intended for the public repo; anchored so
# it doesn't rely solely on tooling-supplied nested ignore files
/.superpowers/

# misc
.cache/
tmp/
