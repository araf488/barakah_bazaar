{
  "extends": "@barakah/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": false,
    "declaration": false,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "global.d.ts",
    "proxy.ts",
    "app",
    "components",
    "lib",
    "i18n",
    "messages",
    "__tests__",
    "test",
    "vitest.config.ts",
    "vitest.setup.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
