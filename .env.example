# ─────────────────────────────────────────────────────────────────────────────
# Barakah Bazaar API — environment template
# Copy to .env and fill in. NEVER commit .env.
# The app boots with only APP_* set; Supabase/Redis vars turn features on.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# Per-environment values for every variable below: see README "Environment matrix".
# Deployed environments (staging, production) must set NODE_ENV explicitly.
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1
LOG_LEVEL=debug
# Comma-separated origins allowed to call this API (storefront, admin portal).
# Fail-closed: an empty value allows no cross-origin browser calls.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
# Swagger is served at /{API_PREFIX}/docs. Never enable in production.
SWAGGER_ENABLED=true

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# DATABASE_URL  — used by the running app. Direct connection (port 5432) is
#                 correct for a long-lived container. Switch to the Supavisor
#                 pooled port 6543 only if you move to serverless.
# DIRECT_URL    — used by `prisma migrate` / `prisma db execute`. Must be the
#                 direct (session-mode) connection; DDL over the transaction
#                 pooler is unreliable.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?schema=public
DIRECT_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?schema=public

# ── Supabase project (Storage only) ──────────────────────────────────────────
# Nothing here takes part in authentication. This API issues its own tokens and
# reads roles from its own tables; Supabase signs upload URLs and nothing else.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SERVER-SIDE ONLY. Bypasses RLS. Never ship to web/admin/Flutter bundles.
SUPABASE_SERVICE_ROLE_KEY=

# ── Redis / BullMQ (optional — async jobs, off by default) ───────────────────
QUEUE_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# Caches session validation (SessionRepository.findByIdWithUser) in Redis, off by default so
# local development and CI need no Redis. Revocation and role/password changes invalidate the
# cache explicitly; the TTL is only a backstop. Uses the REDIS_* settings above.
SESSION_CACHE_ENABLED=false

# ── Email sender (staff invitations) ────────────────────────────────────────
# noop   — logs the recipient instead of sending. While noop is active the
#          invitation endpoint returns the raw token in its response so the
#          flow can be completed without a mailbox.
# resend — free tier (3k/month), needs EMAIL_FROM
# smtp   — any SMTP relay, needs the EMAIL_SMTP_* settings below
# No adapter reads the SMTP settings yet; they are declared here so the whole
# environment contract lives in one place.
EMAIL_PROVIDER=noop
EMAIL_FROM=
EMAIL_SMTP_HOST=
# 587 with STARTTLS, or 465 with EMAIL_SMTP_SECURE=true.
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=false
# How long a password-reset link and code stay valid, in minutes. Max 1440.
PASSWORD_RESET_TTL_MINUTES=60

# ── Payment gateway (Phase 1 — cash on delivery works without any of this) ──
# noop  — REFUSES every online charge. Unlike the SMS noop, which reports
#         success, money fails closed: a gateway that faked a capture would
#         mark orders paid that nobody paid for.
# bkash — needs PAYMENT_APP_KEY and PAYMENT_APP_SECRET from a merchant account.
# Cash on delivery never goes through a gateway, so noop is a working default.
PAYMENT_PROVIDER=noop
PAYMENT_API_URL=
PAYMENT_APP_KEY=
PAYMENT_APP_SECRET=

# ── SMS gateway (phone verification, phone sign-in and order updates) ───────
# Leave SMS_PROVIDER=noop until a local gateway is wired up; noop logs the
# recipient and reports success without sending (the body is logged only when
# NODE_ENV=development). SMS_PROVIDER=alpha-sms REQUIRES SMS_API_URL and
# SMS_API_KEY; startup fails in a deployed environment without them.
# ssl-wireless has no adapter yet and reports every send as failed.
SMS_PROVIDER=noop
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ── Geocoding (map search on the address form) ───────────────────────────────
# noop     — map search disabled; no third party is ever called
# photon   — free and keyless (photon.komoot.io); the default
# geoapify — free tier, needs GEOAPIFY_API_KEY
GEOCODING_PROVIDER=photon
PHOTON_API_URL=https://photon.komoot.io
GEOAPIFY_API_URL=https://api.geoapify.com
# GEOAPIFY_API_KEY=
# Requests per minute, per IP, against the outbound geocoding proxies
GEOCODING_RATE_LIMIT=30

# ── Identity ──────────────────────────────────────────────────────────────────
# HS256 signing secret, 32 characters or more. Leave blank and a random one is generated per
# boot with a warning — REQUIRED in staging and production, where a per-process key would
# invalidate every other instance's tokens.
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
# base64, 32 bytes. Encrypts TOTP secrets at rest. REQUIRED in staging and production:
# without it no staff member with MFA enrolled can sign in.
TOTP_ENCRYPTION_KEY=
SCRYPT_COST_LOG2=
SCRYPT_BLOCK_SIZE=
SCRYPT_PARALLELISM=
# Requests per minute, per caller IP, against login, MFA verification and refresh
AUTH_RATE_LIMIT=10
# Requests per minute, per submitted account (email), against the same routes — bounds a
# distributed attempt against one account spread across many IPs
AUTH_ACCOUNT_RATE_LIMIT=20
# Requests per minute, per submitted phone number, against all four /auth/phone routes
AUTH_PHONE_RATE_LIMIT=5
# Seconds a number must wait before another code (verification or sign-in) may be sent to it
PHONE_CODE_RESEND_COOLDOWN_SECONDS=60
# Codes one number may be sent per rolling 24 hours (verification and sign-in codes together)
PHONE_CODE_DAILY_LIMIT_PER_NUMBER=5
# Verification codes one signed-in account may request per rolling 24 hours, to any numbers
PHONE_CODE_DAILY_LIMIT_PER_ACCOUNT=5
# Total SMS the app may send per day across all numbers (a ceiling on SMS spend)
SMS_DAILY_LIMIT=500
# How long a resolved auth-settings read is cached before the next request re-queries it.
# Session validation runs on every authenticated request, so leaving this at its default
# (rather than deleting the line) keeps that lookup off the hot path.
AUTH_SETTINGS_CACHE_SECONDS=60
SESSION_TOUCH_INTERVAL_MINUTES=
# Base for verification and reset links. NEVER derived from the request Host header.
# Must begin with https:// in staging and production — these links carry a credential.
APP_PUBLIC_BASE_URL=

# ── API rate limiting ─────────────────────────────────────────────────────────
# Writes per minute, per caller, per endpoint (POST/PATCH/PUT/DELETE). Reads are not
# limited at this layer. Endpoints needing a tighter bound carry their own bucket:
# login, MFA and refresh are held to AUTH_RATE_LIMIT and AUTH_ACCOUNT_RATE_LIMIT above.
WRITE_RATE_LIMIT=
